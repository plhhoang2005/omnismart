# Copy to .env for local development. Never commit real values.
APP_ENV=local
DATABASE_URL=jdbc:postgresql://localhost:5432/omnismart
DATABASE_USERNAME=omnismart
DATABASE_PASSWORD=omnismart-local
POSTGRES_DB=omnismart
POSTGRES_USER=omnismart
POSTGRES_PASSWORD=omnismart-local
POSTGRES_PORT=5432
GOOGLE_CLIENT_ID=replace-with-local-client-id
GOOGLE_CLIENT_SECRET=replace-with-local-secret
GEMINI_API_KEY=replace-with-local-api-key
