# Copy to .env for local development. Never commit real values.
APP_ENV=local
DATABASE_URL=jdbc:postgresql://localhost:5432/omnismart
DATABASE_USERNAME=omnismart
DATABASE_PASSWORD=omnismart-local
POSTGRES_DB=omnismart
POSTGRES_USER=omnismart
POSTGRES_PASSWORD=omnismart-local
POSTGRES_PORT=5432
GOOGLE_CLIENT_ID=replace-with-local-client-id
GOOGLE_CLIENT_SECRET=replace-with-local-secret
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
OAUTH_RATE_LIMIT_MAX_REQUESTS=10
OAUTH_RATE_LIMIT_WINDOW=PT1M
MEMBERSHIP_INVITATION_TTL=PT72H
PRODUCT_MEDIA_STORAGE_ROOT=./data/product-media
PRODUCT_MEDIA_MAX_FILE_SIZE=5MB
PRODUCT_MEDIA_MAX_IMAGES=8
PRODUCT_MEDIA_TEMPORARY_RETENTION=PT24H
PRODUCT_MEDIA_CLEANUP_INTERVAL=PT1H
PRODUCT_MEDIA_CLEANUP_INITIAL_DELAY=PT1H
PRODUCT_MEDIA_CLEANUP_BATCH_SIZE=100
PRODUCT_MEDIA_MULTIPART_MAX_FILE_SIZE=6MB
PRODUCT_MEDIA_MULTIPART_MAX_REQUEST_SIZE=6MB
GEMINI_API_KEY=replace-with-local-api-key
